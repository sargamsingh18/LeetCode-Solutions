class Solution {
public:
    int minElement(vector<int>& nums) {
        int n=nums.size();
        int m=INT_MAX;
        for(int i=0;i<n;i++)
        {
            int num=nums[i];
            int sum=0;
            while(num!=0){
                int r=num%10;
                num=num/10;
                sum+=r;
                
            }
            if(sum<m){
                m=sum;
            }
            
        }
        return m;
        
    }
};
